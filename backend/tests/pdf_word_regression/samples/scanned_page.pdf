рххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххр€€€€€€ххрххрххрххр€€€€€€ххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххрххр€€€€€€ххрххрххрххр€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€